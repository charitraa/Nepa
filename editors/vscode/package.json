{
  "name": "nepa-lang",
  "displayName": "NepLang",
  "description": "NepLang language support: file icon and syntax highlighting",
  "publisher": "local",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "neplang",
        "aliases": [
          "NepLang",
          "neplang"
        ],
        "extensions": [
          ".np"
        ],
        "icon": {
          "light": "./np-file-icon.png",
          "dark": "./np-file-icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "neplang",
        "scopeName": "source.neplang",
        "path": "./syntaxes/neplang.tmLanguage.json"
      }
    ]
  },
  "icon": "neplang-logo.png"
}
